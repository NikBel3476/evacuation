{
    "identifier": "main-capability",
    "description": "Capability for the main window",
    "windows": ["evacuation"],
    "permissions": [
        "path:default",
        "event:default",
        "window:default",
        "app:default",
        "resources:default",
        "menu:default",
        "tray:default",
        "window:allow-set-title",
        "dialog:allow-open",
        "dialog:allow-save",
        "fs:allow-read-text-file",
        "fs:allow-read-dir"
    ]
}